# === Naver 오픈 API (검색 순위 조회에 사용, 권장) ===
# https://developers.naver.com/apps/#/register 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === SerpApi (Google 순위 조회에 사용, 선택 - 미설정 시 requests 스크래핑으로 대체) ===
# https://serpapi.com 에서 발급 (무료 플랜: 월 100회)
SERPAPI_KEY=

# === Kakao ("나에게 보내기" 알림에 사용) ===
# https://developers.kakao.com 에서 앱 생성 후 REST API 키 발급
KAKAO_REST_API_KEY=
# Kakao 개발자 콘솔 > 카카오 로그인 > Redirect URI 에 등록한 값과 동일해야 함
KAKAO_REDIRECT_URI=https://localhost.com/oauth

# === 기타 설정 ===
# 순위 조회 시 확인할 최대 검색결과 개수
MAX_RESULTS_TO_CHECK=50
