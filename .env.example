# === SerpApi (Google 순위 조회에 사용, 선택 - 미설정 시 Selenium 스크래핑으로 대체) ===
# https://serpapi.com 에서 발급 (무료 플랜: 월 100회)
SERPAPI_KEY=

# === Kakao ("나에게 보내기" 알림에 사용) ===
# https://developers.kakao.com 에서 앱 생성 후 REST API 키 발급
KAKAO_REST_API_KEY=
# Kakao 개발자 콘솔 > 카카오 로그인 > Redirect URI 에 등록한 값과 동일해야 함
KAKAO_REDIRECT_URI=https://localhost.com/oauth
# Kakao 개발자 콘솔 > 카카오 로그인 > 보안 에서 Client Secret을 "사용함(필수)"으로
# 설정한 경우에만 그 값을 입력. 그 외에는 비워둔다.
KAKAO_CLIENT_SECRET=

# === 기타 설정 ===
# 순위 조회 시 확인할 최대 검색결과 개수. 구글 모바일 검색은 10개 단위로만
# 더 가져올 수 있어(SerpApi start 파라미터로 페이지 넘김), 이 값이 클수록
# 키워드 하나당 SerpApi 호출 횟수가 늘어난다(20=최대 2회, 50=최대 5회).
# SerpApi 무료 플랜(월 100회) 안에서 넉넉히 쓰려면 20 권장.
MAX_RESULTS_TO_CHECK=20
